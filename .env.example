# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env.example)
# INTRANET POWERLINK CORP
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y nómbralo como '.env' en la raíz del proyecto.
# 2. En entornos locales de desarrollo, puedes dejar los campos SMTP en blanco.
#    El sistema activará automáticamente el modo MOCK (simulación segura),
#    permitiéndote probar el flujo de creación y edición sin requerir credenciales reales.
# 3. NUNCA subas el archivo '.env' con contraseñas reales a Git.
# ==============================================================================

# --- BASE DE DATOS ---
# Producción/Servidor: postgresql://usuario:password@localhost:5432/intranet_db
# Local (Fallback automático a SQLite si PostgreSQL no está disponible):
DATABASE_URL=sqlite:///./intranet_local.db
SQLITE_FALLBACK_URL=sqlite:///./intranet_local.db

# --- SEGURIDAD Y TOKENS JWT ---
SECRET_KEY=cambiar_en_produccion_por_un_hash_aleatorio_seguro
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- ARCHIVOS Y UPLOADS ---
UPLOAD_DIR=static/uploads

# --- SERVICIO DE CORREO ELECTRÓNICO (SMTP) ---
# En entornos locales/colaboradores: Déjalos vacíos para activar el modo MOCK seguro.
# En el servidor de producción: Configura las credenciales reales de SMTP2GO o el proveedor oficial.
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=notificaciones@powerlink.com
